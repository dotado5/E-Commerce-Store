{
  "family": "ecommerce-storefront",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecommerceTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "storefront",
      "image": "<IMAGE>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "API_URL", "value": "http://store.ecommerce.local:5000" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/ >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecommerce-storefront",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "storefront",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
