# Database
DATABASE_URL=postgresql://store:store@localhost:5433/store

# Auth
JWT_SECRET=change-me

# Redis (optional — caching is silently disabled if unreachable)
REDIS_URL=redis://localhost:6379

# Stripe (optional — when STRIPE_SECRET_KEY is unset, orders are created
# without a payment intent). Use TEST keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# Publishable key, served to the storefront via GET /payments/config
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret, e.g. from:
#   stripe listen --forward-to localhost:3000/payments/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd

# SMTP (optional — when SMTP_HOST is unset, order confirmation emails
# are rendered and logged to the console instead of being sent)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="E-Commerce Store" <no-reply@store.local>
